# =============================================================================
# Cálculo Aberto — variáveis de ambiente
# =============================================================================
# Copie para .env.local e preencha conforme o ambiente.
# NENHUM valor real deve ser commitado neste arquivo.
#
# ATENÇÃO: variáveis com prefixo NEXT_PUBLIC_ ficam visíveis no navegador.
# Nunca coloque segredo em uma delas.
#
# Detalhamento por ambiente: docs/13-deployment.md §5
# =============================================================================


# -----------------------------------------------------------------------------
# APLICAÇÃO
# -----------------------------------------------------------------------------

# URL pública do site, sem barra final.
# Usada em canônicas, sitemap e metadados de compartilhamento.
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# ANÚNCIO  (somente produção)
# -----------------------------------------------------------------------------
# Deixe vazio em desenvolvimento — nenhum script de anúncio é carregado.
# Vazio também em CI, para que os testes de vazamento rodem sem terceiros
# antes de rodarem com eles (TC-043).

# Identificador público da conta na rede de anúncio.
# Não é segredo: aparece no HTML servido ao usuário.
NEXT_PUBLIC_AD_CLIENT_ID=

# Identificador do slot único, posicionado abaixo do resultado.
# Regras de posicionamento: docs/10-ux-ui-spec.md §9
NEXT_PUBLIC_AD_SLOT_ID=

# Identificador da plataforma de gestão de consentimento.
# Sem consentimento, nenhum script de terceiro é executado (RF-009).
NEXT_PUBLIC_CMP_ID=


# -----------------------------------------------------------------------------
# ANÁLISE DE USO  (autohospedada, sem cookie — ADR-005)
# -----------------------------------------------------------------------------
# Deixe vazio em desenvolvimento.
# Eventos transmitem apenas identificador de calculadora e nome do evento.
# Nunca valores digitados (RN-031).

# URL do script da instância autohospedada.
NEXT_PUBLIC_ANALYTICS_URL=

# Identificador do site na instância.
NEXT_PUBLIC_ANALYTICS_SITE_ID=


# -----------------------------------------------------------------------------
# REGISTRO DE ERROS  (somente produção)
# -----------------------------------------------------------------------------
# A configuração DEVE remover query string, corpo de requisição e conteúdo
# de campos antes do envio. Ver docs/14-observability.md §2.3 (E-1 a E-6).
# Verificado por TC-041 a cada deploy.

# Endereço público de envio de eventos de erro.
SENTRY_DSN=

# Token de envio de mapas de origem.
# SEGREDO — apenas no cofre do CI. Nunca em .env.local commitado.
SENTRY_AUTH_TOKEN=


# -----------------------------------------------------------------------------
# SÉRIE ECONÔMICA EXTERNA  (build — ADR-006)
# -----------------------------------------------------------------------------
# Consumida no pipeline e em revalidação diária. Nunca em requisição
# do usuário. Falha não interrompe o build (regra R-3).

# Endereço-base do serviço público de séries temporais.
# VERIFICAR: confirmar na documentação oficial do provedor antes de usar.
BCB_API_BASE_URL=

# Identificador da série usada na sugestão de taxa em CALC-022.
# VERIFICAR: confirmar o identificador correto na documentação oficial.
BCB_SERIES_ID=

# Tempo limite da requisição, em milissegundos.
BCB_TIMEOUT_MS=3000


# -----------------------------------------------------------------------------
# ENTREGA CONTÍNUA  (somente CI)
# -----------------------------------------------------------------------------
# Todas SEGREDO. Vivem apenas no cofre do repositório.

# Endereço de disparo do deploy no painel de hospedagem.
DEPLOY_WEBHOOK_URL=

# Token de publicação da imagem no registro de contêineres.
REGISTRY_TOKEN=


# -----------------------------------------------------------------------------
# ANÁLISE DE USO — INFRAESTRUTURA  (somente VPS)
# -----------------------------------------------------------------------------
# Pertencem ao contêiner da ferramenta de análise, NÃO à aplicação.
# A aplicação não conhece este banco e funciona integralmente sem ele.
# Configuradas no painel da VPS, nunca no repositório. Ambas SEGREDO.

# String de conexão do banco da ferramenta de análise.
UMAMI_DATABASE_URL=

# Segredo de sessão da ferramenta de análise.
UMAMI_APP_SECRET=


# =============================================================================
# NOTA
# =============================================================================
# Não existe variável de banco de dados da aplicação, nem de autenticação,
# nem de pagamento. A ausência é deliberada e está registrada em ADR-002.
# Se você precisou adicionar uma, reverta a decisão conscientemente e
# atualize docs/04-architecture.md, docs/07-security.md e o próprio ADR.
# =============================================================================
