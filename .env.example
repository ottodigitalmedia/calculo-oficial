# =============================================================================
# Cálculo Oficial — variáveis de ambiente
# =============================================================================
# Copie para .env.local e preencha conforme o ambiente.
# NENHUM valor real deve ser commitado neste arquivo.
#
# ATENÇÃO: variáveis com prefixo NEXT_PUBLIC_ ficam visíveis no navegador.
# Nunca coloque segredo em uma delas.
#
# Detalhamento por ambiente: docs/13-deployment.md §5
# =============================================================================


# -----------------------------------------------------------------------------
# APLICAÇÃO
# -----------------------------------------------------------------------------

# URL pública do site, sem barra final.
# Usada em canônicas, sitemap e metadados de compartilhamento.
#
# Local     : http://localhost:3000
# Produção  : https://calculoficial.com.br
#
# Entra no BUILD, não em runtime: o prefixo NEXT_PUBLIC_ é substituído no
# bundle. Mudar o domínio exige rebuild, não só reconfigurar o painel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# ANÚNCIO  (somente produção)
# -----------------------------------------------------------------------------
# Deixe vazio em desenvolvimento — nenhum script de anúncio é carregado.
# Vazio também em CI, para que os testes de vazamento rodem sem terceiros
# antes de rodarem com eles (TC-043).

# Identificador público da conta na rede de anúncio.
# Não é segredo: aparece no HTML servido ao usuário.
NEXT_PUBLIC_AD_CLIENT_ID=

# Identificador do slot único, posicionado abaixo do resultado.
# Regras de posicionamento: docs/10-ux-ui-spec.md §9
NEXT_PUBLIC_AD_SLOT_ID=

# Identificador da plataforma de gestão de consentimento.
# Sem consentimento, nenhum script de terceiro é executado (RF-009).
NEXT_PUBLIC_CMP_ID=


# -----------------------------------------------------------------------------
# ANÁLISE DE USO  (Google Tag Manager + GA4 — INT-005, revisto em 07/08/2026)
# -----------------------------------------------------------------------------
# Deixe vazio em desenvolvimento: SEM ESTA VARIÁVEL NADA DE TERCEIRO CARREGA,
# e é assim que a e2e mede o produto em vez da integração (RNF-007).
#
# Eventos transmitem apenas identificador de calculadora e nome do evento.
# Nunca valores digitados (RN-031).
#
# CUIDADO QUE NÃO ESTÁ AQUI, E SIM NO PAINEL: RF-006 põe o estado do formulário
# na query, então location.search contém o salário de quem usa o site. A
# sanitização está em components/Medicao.tsx, mas a etiqueta do GA4 no GTM
# precisa usar as variáveis de dataLayer (page_location, page_path) em vez de
# "Page URL". Apontá-la para Page URL contorna tudo isso sem que nada no
# repositório mude nem reprove. Ver 06-api-spec R-5.

# Identificador do contêiner. Formato GTM-XXXXXXX; qualquer outra coisa é
# recusada pelo componente, que então não carrega nada.
NEXT_PUBLIC_GTM_ID=


# -----------------------------------------------------------------------------
# VERIFICAÇÃO DE DEPLOY  (EP-016)
# -----------------------------------------------------------------------------
# SEGREDO. Precisa do MESMO valor em dois lugares: no cofre do repositório
# (para o pipeline mandar no cabeçalho) e no painel do EasyPanel (para o
# contêiner reconhecer).
#
# Com ele, /api/health devolve a revisão a quem apresenta o cabeçalho
# x-health-token, e o pipeline passa a saber se falou com o contêiner NOVO. Sem
# ele, a rota nunca revela nada e o pipeline avisa que não conseguiu confirmar
# — degrada para "não sei", nunca para "versão exposta".
#
# Existe porque em 07/08/2026 o pipeline aprovou dois deploys que não
# aconteceram: a verificação lia "ok" do contêiner antigo, que responde igual.
HEALTH_TOKEN=


# -----------------------------------------------------------------------------
# FORMULÁRIO DE CONTATO  (EP-017)
# -----------------------------------------------------------------------------
# Sem estas variáveis o formulário responde "envio indisponível" e mostra o
# endereço direto — NUNCA aceita em silêncio. Mensagem engolida é pior que
# formulário que se declara fora do ar.
#
# Servem a um SMTP qualquer: o e-mail do próprio domínio, ou uma conta com senha
# de aplicativo. A mensagem sai do servidor direto para a caixa de entrada, sem
# intermediário — não há operador de dados novo nesta escolha.
#
# SMTP_PASSWORD é SEGREDO e vive só no painel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Para onde a mensagem vai, e de quem ela parece vir. O remetente costuma
# precisar ser o mesmo usuário autenticado, ou o provedor recusa o envio.
CONTATO_DESTINO=
CONTATO_REMETENTE=


# -----------------------------------------------------------------------------
# REGISTRO DE ERROS  (somente produção)
# -----------------------------------------------------------------------------
# A configuração DEVE remover query string, corpo de requisição e conteúdo
# de campos antes do envio. Ver docs/14-observability.md §2.3 (E-1 a E-6).
# Verificado por TC-041 a cada deploy.

# Endereço público de envio de eventos de erro.
SENTRY_DSN=

# Token de envio de mapas de origem.
# SEGREDO — apenas no cofre do CI. Nunca em .env.local commitado.
SENTRY_AUTH_TOKEN=


# -----------------------------------------------------------------------------
# SÉRIE ECONÔMICA EXTERNA  (build — ADR-006)
# -----------------------------------------------------------------------------
# Consumida no pipeline e em revalidação diária. Nunca em requisição
# do usuário. Falha não interrompe o build (regra R-3).

# Endereço-base do serviço público de séries temporais.
# VERIFICAR: confirmar na documentação oficial do provedor antes de usar.
BCB_API_BASE_URL=

# Identificador da série usada na sugestão de taxa em CALC-022.
# VERIFICAR: confirmar o identificador correto na documentação oficial.
BCB_SERIES_ID=

# Tempo limite da requisição, em milissegundos.
BCB_TIMEOUT_MS=3000


# -----------------------------------------------------------------------------
# ENTREGA CONTÍNUA  (somente CI)
# -----------------------------------------------------------------------------
# Todas SEGREDO. Vivem apenas no cofre do repositório.

# Endereço de disparo do deploy no painel de hospedagem.
DEPLOY_WEBHOOK_URL=

# Token de publicação da imagem no registro de contêineres.
# SÓ é necessário se o registro for externo ao GitHub. Com o registro de
# contêineres do próprio GitHub, o workflow usa o token efêmero da execução
# e não há segredo a guardar nem a rotacionar.
REGISTRY_TOKEN=


# -----------------------------------------------------------------------------
# ANÁLISE DE USO — INFRAESTRUTURA  (somente VPS)
# -----------------------------------------------------------------------------
# SUPERADAS EM 07/08/2026, e mantidas aqui como registro por um tempo.
#
# Pertenciam ao contêiner da análise AUTOHOSPEDADA, que INT-005 previa antes de
# o mantenedor optar por GTM e GA4. Não há mais banco de análise a hospedar: a
# ferramenta passou a ser de terceiro, e a aplicação nunca conheceu este banco
# de qualquer modo.
#
# Ficam vazias. Removê-las junto com o docker-compose da análise é limpeza a
# fazer quando alguém confirmar que a instância antiga não subiu em produção.
UMAMI_DATABASE_URL=
UMAMI_APP_SECRET=
UMAMI_DB_USER=
UMAMI_DB_PASSWORD=


# -----------------------------------------------------------------------------
# EMPACOTAMENTO  (somente CI)
# -----------------------------------------------------------------------------

# Hash do commit. Vira a etiqueta da imagem e o rótulo
# org.opencontainers.image.revision, que é o que torna o rollback possível e
# permite descobrir o que está no ar durante um incidente (regra D-5).
VCS_REF=


# =============================================================================
# NOTA
# =============================================================================
# Não existe variável de banco de dados da aplicação, nem de autenticação,
# nem de pagamento. A ausência é deliberada e está registrada em ADR-002.
# Se você precisou adicionar uma, reverta a decisão conscientemente e
# atualize docs/04-architecture.md, docs/07-security.md e o próprio ADR.
# =============================================================================
